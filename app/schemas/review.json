{
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string" },
          "blocking": { "type": "boolean" }
        },
        "required": ["name", "passed", "evidence", "blocking"],
        "additionalProperties": false
      }
    },
    "claimChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimIndex": { "type": "integer", "minimum": 0 },
          "materialId": { "type": "string" },
          "locator": { "type": "string", "pattern": "^L[0-9]+-L[0-9]+$" },
          "verdict": { "type": "string", "enum": ["supported", "unsupported", "uncertain"] },
          "evidence": { "type": "string" }
        },
        "required": ["claimIndex", "materialId", "locator", "verdict", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "checks", "claimChecks"],
  "additionalProperties": false
}

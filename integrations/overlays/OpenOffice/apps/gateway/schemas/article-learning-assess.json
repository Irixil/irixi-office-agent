{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": { "type": "string", "enum": ["correct", "partial", "incorrect", "unevaluated"] },
    "correct": { "type": "array", "items": { "type": "string" } },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "conceptId": { "type": "string" }, "claim": { "type": "string" }, "why": { "type": "string" }, "location": { "type": "string" } },
        "required": ["conceptId", "claim", "why", "location"],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "conceptId": { "type": "string" }, "location": { "type": "string" }, "text": { "type": "string" } },
        "required": ["conceptId", "location", "text"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "conceptId": { "type": "string" }, "location": { "type": "string" }, "quote": { "type": "string" }, "reason": { "type": "string" } },
        "required": ["conceptId", "location", "quote", "reason"],
        "additionalProperties": false
      }
    },
    "remediation": {
      "type": "object",
      "properties": { "explanation": { "type": "string" }, "example": { "type": "string" } },
      "required": ["explanation", "example"],
      "additionalProperties": false
    },
    "retest": {
      "type": "object",
      "properties": { "question": { "type": "string" }, "unseenWhy": { "type": "string" } },
      "required": ["question", "unseenWhy"],
      "additionalProperties": false
    },
    "conceptResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "type": "string", "enum": ["verified", "weak", "untested"] },
          "evidenceIndexes": { "type": "array", "items": { "type": "integer" } },
          "deficiency": {
            "anyOf": [
              { "type": "object", "properties": { "type": { "type": "string", "enum": ["error", "omission"] }, "index": { "type": "integer" } }, "required": ["type", "index"], "additionalProperties": false },
              { "type": "null" }
            ]
          }
        },
        "required": ["id", "label", "status", "evidenceIndexes", "deficiency"],
        "additionalProperties": false
      }
    },
    "activityQualification": {
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "requestedType": { "type": "string" },
        "semanticType": { "type": "string", "enum": ["cause", "misconception", "application", "transfer", "retest", "other"] },
        "supported": { "type": "boolean" },
        "unseen": { "type": "boolean" },
        "sourceTurnId": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "required": ["question", "requestedType", "semanticType", "supported", "unseen", "sourceTurnId", "rationale"],
      "additionalProperties": false
    }
  },
  "required": ["verdict", "correct", "errors", "omissions", "evidence", "remediation", "retest", "conceptResults", "activityQualification"],
  "additionalProperties": false
}
